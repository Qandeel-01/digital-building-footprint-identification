# Keep the build context small and deterministic. Anything that is
# generated by running the pipeline, or is secret, stays out.

# Python / tool caches
__pycache__/
*.py[cod]
*.egg
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Virtualenvs on the host
.venv/
venv/
env/

# Benchmark artifacts (produced by running the pipeline, not inputs)
weights/
data/
output/
runs/

# Secrets
.env
.env.*
!.env.example

# Editor / OS cruft
.idea/
.vscode/
.DS_Store
Thumbs.db

# Host-side git metadata we do not need in the image. NOTE: external/abd/.git
# IS intentionally kept because scripts/apply_upstream_patches.py shells out
# to `git -C external/abd ...` to apply patches on top of the pinned SHA.
.git/
.github/
