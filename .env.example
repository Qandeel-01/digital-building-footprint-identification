# Copy to `.env` and fill in values. `.env` is gitignored.
#
# AWS credentials are NOT required to read from the SpaceNet 2 public bucket
# (s3://spacenet-dataset/). bfbench uses anonymous (unsigned) requests by
# default. Set these only if you need signed access for a different bucket
# or if AWS SDK is otherwise misbehaving in your shell.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Path to the pretrained checkpoint fetched by scripts/fetch_weights.py.
# Default resolves to `<repo>/weights/neat-fullxview-epoch75.pth`.
# BFBENCH_WEIGHTS=
