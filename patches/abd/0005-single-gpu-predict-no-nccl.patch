Support single-GPU predict without NCCL / DDP.

Upstream `abd predict` unconditionally launches with
`torch.distributed` on the NCCL backend, via `mp.spawn`. This fails
at the assertion on any platform where NCCL is not available
(notably PyTorch's Windows build). Even on Linux, running with one
GPU should not require multiprocessing scaffolding.

This patch adds a `--single-gpu` flag which:
    * skips the NCCL availability assertion,
    * runs prediction inline on cuda:0 (or cpu if no CUDA),
    * bypasses `mp.spawn` and DistributedDataParallel entirely.

Multi-GPU behaviour is unchanged when the flag is not passed.

diff --git a/abd_model/src/abd_model/tools/predict.py b/abd_model/src/abd_model/tools/predict.py
--- a/abd_model/src/abd_model/tools/predict.py
+++ b/abd_model/src/abd_model/tools/predict.py
@@ -35,6 +35,11 @@ def add_parser(subparser, formatter_class):
     perf = parser.add_argument_group("Performances")
     perf.add_argument("--bs", type=int, help="batch size [default: CPU/GPU]")
     perf.add_argument("--workers", type=int, help="number of pre-processing images workers, per GPU [default: batch_size]")
+    perf.add_argument(
+        "--single-gpu", action="store_true",
+        help="Run prediction on a single device without torch.distributed/NCCL. "
+             "Required on platforms without NCCL (e.g. Windows).",
+    )

     ui = parser.add_argument_group("Web UI")
     ui.add_argument("--web_ui_base_url", type=str, help="alternate Web UI base URL")
@@ -102,7 +107,8 @@ def main(args):
     check_classes(config)

     assert torch.cuda.is_available(), "No GPU support found. Check CUDA and NVidia Driver install."
-    assert torch.distributed.is_nccl_available(), "No NCCL support found. Check your PyTorch install."
+    if not getattr(args, "single_gpu", False):
+        assert torch.distributed.is_nccl_available(), "No NCCL support found. Check your PyTorch install (or pass --single-gpu)."

     world_size = torch.cuda.device_count()
     args.bs = args.bs if args.bs is not None else math.floor(os.cpu_count() / world_size)
@@ -132,7 +138,10 @@ def main(args):
         keep_borders=args.keep_borders,
     )

-    mp.spawn(gpu_worker, nprocs=world_size, args=(world_size, lock_file, args, config, dataset, palette, transparency))
+    if getattr(args, "single_gpu", False):
+        gpu_worker(0, 1, lock_file, args, config, dataset, palette, transparency)
+    else:
+        mp.spawn(gpu_worker, nprocs=world_size, args=(world_size, lock_file, args, config, dataset, palette, transparency))

     if os.path.exists(lock_file):
         os.remove(lock_file)
