Replace removed webcolors.CSS3_NAMES_TO_HEX with the modern name_to_hex API.

webcolors dropped the CSS3_NAMES_TO_HEX dict constant in release 1.13
(2023). The replacement API `webcolors.name_to_hex(name)` has been
available since webcolors 1.0 and is what upstream should be using.
Pure API-swap patch; no behaviour change.

diff --git a/abd_model/src/abd_model/core.py b/abd_model/src/abd_model/core.py
index 03f45a2..c6e56fe 100644
--- a/abd_model/src/abd_model/core.py
+++ b/abd_model/src/abd_model/core.py
@@ -134,7 +134,7 @@ def make_palette(colors, complementary=False):
         transparency = None

     colors = ["white" if color.lower() == "transparent" else color for color in colors]
-    hex_colors = [webcolors.CSS3_NAMES_TO_HEX[color.lower()] if color[0] != "#" else color for color in colors]
+    hex_colors = [webcolors.name_to_hex(color.lower()) if color[0] != "#" else color for color in colors]
     rgb_colors = [(int(h[1:3], 16), int(h[3:5], 16), int(h[5:7], 16)) for h in hex_colors]

     palette = list(sum(rgb_colors, ()))  # flatten
@@ -161,7 +161,7 @@ def check_color(color):
     """Check if an input color is or not valid (i.e CSS3 color name, transparent, or #RRGGBB)."""

     color = "white" if color.lower() == "transparent" else color
-    hex_color = webcolors.CSS3_NAMES_TO_HEX[color.lower()] if color[0] != "#" else color
+    hex_color = webcolors.name_to_hex(color.lower()) if color[0] != "#" else color
     return bool(re.match(r"^#([0-9a-fA-F]){6}$", hex_color))


